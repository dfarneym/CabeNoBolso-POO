								"$ref": "AAAAAAGhqAD0gKVIEXU="
							},
							"lineStyle": 1,
							"points": "1181:1055;986:838",
							"showVisibility": true,
							"nameLabel": {
								"$ref": "AAAAAAGhsi+6tINAkC0="
							},
							"stereotypeLabel": {
								"$ref": "AAAAAAGhsi+6tYNBkec="
							},
							"propertyLabel": {
								"$ref": "AAAAAAGhsi+6tYNCqJQ="
							}
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGhsmTWQYPDgYw=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"fillColor": "$orange11",
							"fontColor": "$slate1",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 16,
							"top": 120,
							"width": 144,
							"height": 189,
							"text": "Planejamento — Marcos\r\n\r\nGerencia participantes e despesas.\r\nImpede códigos duplicados e vínculos inválidos.\r\nCalcula gastos individuais, total geral e situação do orçamento."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGhsmfamoPgkZo=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"head": {
								"$ref": "AAAAAAGhpzlEEqNjKa0="
							},
							"tail": {
								"$ref": "AAAAAAGhsmTWQYPDgYw="
							},
							"lineStyle": 1,
							"points": "161:210;191:208"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGhsnLgY+wRhvU=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"fillColor": "$blue11",
							"fontColor": "$background",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 1712,
							"top": 136,
							"width": 168,
							"height": 144,
							"text": "Participante — Sarah\r\n\r\nRepresenta uma pessoa do planejamento.\r\nArmazena código, nome e orçamento.\r\nValida seus dados e protege os atributos."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGhsnPIYuwmR6o=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"head": {
								"$ref": "AAAAAAGhou4saqWrVak="
							},
							"tail": {
								"$ref": "AAAAAAGhsnLgY+wRhvU="
							},
							"lineStyle": 1,
							"points": "1711:198;1530:175"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGhsnUcDOwrisg=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"fillColor": "$purple11",
							"fontColor": "$background",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 1272,
							"top": 656,
							"width": 184,
							"height": 152,
							"text": "Despesa — Yasmin\r\n\r\nClasse abstrata que reúne os dados comuns às despesas.\r\nDefine os métodos de cálculo que as subclasses devem implementar.\r\nPermite utilizar herança e polimorfismo."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGhsnV3yOw2E3I=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"head": {
								"$ref": "AAAAAAGhp/MA1qSB8wI="
							},
							"tail": {
								"$ref": "AAAAAAGhsnUcDOwrisg="
							},
							"lineStyle": 1,
							"points": "1271:731;1124:729"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGhsnh5+OxBRQc=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"fillColor": "$mint9",
							"fontColor": "$slate1",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 512,
							"top": 1288,
							"width": 208,
							"height": 165,
							"text": "DespesaFixa — Yasmin\r\n\r\nRepresenta uma despesa com valor total fixo.\r\nDivide o valor entre os participantes selecionados.\r\nDistribui centavos restantes por ordem crescente do código.\r\nNão cobra participantes não envolvidos."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGhsnloguxUfjU=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"head": {
								"$ref": "AAAAAAGhqADBoKUiWzU="
							},
							"tail": {
								"$ref": "AAAAAAGhsnh5+OxBRQc="
							},
							"lineStyle": 1,
							"points": "609:1287;597:1153"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGhsn7DruxdZQQ=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"fillColor": "$pink12",
							"fontColor": "$background",
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 1128,
							"top": 1248,
							"width": 190.89892578125,
							"height": 191,
							"text": "DespesaPorPessoa — Yasmin\r\n\r\nRepresenta uma despesa com valor unitário.\r\nCada participante selecionado paga esse valor.\r\nO total é o valor unitário multiplicado pela quantidade de participantes.\r\nNão cobra participantes não envolvidos."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGhsn+TRuxy2Do=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
